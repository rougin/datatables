{
  "name": "rougin/datatables",
  "description": "Handles server-side of DataTables in PHP.",
  "keywords": [ "datatable", "php-datatables", "php-table" ],
  "homepage": "https://roug.in/datatables/",
  "license": "MIT",
  "authors":
  [
    {
      "email": "rougingutib@gmail.com",
      "homepage": "https://roug.in/",
      "name": "Rougin Gutib",
      "role": "Software Engineer"
    }
  ],
  "require":
  {
    "php": ">=5.3.0",
    "rougin/ezekiel": "dev-master"
  },
  "autoload":
  {
    "psr-4":
    {
      "Rougin\\Datatables\\": "src/"
    }
  },
  "autoload-dev":
  {
    "psr-4":
    {
      "Rougin\\Datatables\\": "tests/"
    }
  },
  "require-dev":
  {
    "phpunit/phpunit": "*",
    "sanmai/phpunit-legacy-adapter": "*",
    "robmorgan/phinx": "~0.1"
  },
  "scripts":
  {
    "analyze": "phpstan analyse",
    "restyle": "php-cs-fixer fix --config=phpstyle.php",
    "test": "phpunit"
  }
}